{
  "manifest_version": 3,
  "name": "Glassy Dashboard",
  "version": "1.0",
  "description": "Aura styled browser UI with custom New Tab dashboard",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "bookmarks",
    "topSites",
    "favicon"
  ],
  "icons": {
    "16": "./favicon.png",
    "32": "./favicon.png",
    "48": "./favicon.png",
    "128": "./favicon.png"
  }
}