{
  "manifest_version": 3,
  "name": "Glassy Dashboard",
  "version": "1.0",
  "description": "Aura styled browser UI with custom New Tab dashboard",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "bookmarks",
    "topSites"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
